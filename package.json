    "anthropic",
    "openai",
    "openrouter",
    "sakana",
    "fugu",
    "proxy",
    "justgains",
    "justimagine",
    "image-generation",
    "video-generation",
    "text-to-video",
    "veo",
    "sora",
    "seedance",
    "claude-skill",
    "agent-skill"
  ],
  "author": "JustGains (https://justgains.com)",
  "license": "MIT",
  "homepage": "https://justgains.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JustSuperHuman/bro-cli.git"
  },
  "bugs": {
    "url": "https://github.com/JustSuperHuman/bro-cli/issues"
  },
  "dependencies": {
    "ccusage": "20.0.19"
  }
}
