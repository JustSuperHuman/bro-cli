{
  "name": "bro-claude",
  "version": "0.4.3",
  "description": "Run Claude Code, omp, Pi, Codex, or DeepSeek Harness against native, OpenAI-compatible, and Anthropic-compatible model providers — plus JustImagine, a self-hosted image and video generation gallery.",
  "type": "module",
  "bin": {
    "bro": "bin/bro.js"
  },
  "files": [
    "bin",
    "src",
    "vendor/justimagine/src",
    "vendor/justimagine/skills",
    "vendor/justimagine/models.json",
    "vendor/justimagine/video-models.json",
    "vendor/justimagine/package.json",
    "vendor/justimagine/LICENSE",
    "pool",
    "dsh-plugin-profiles",
    "skills",
    "models.json",
    "video-models.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/bro.js",
    "bro": "node bin/bro.js",
    "deploy": "node scripts/deploy.js",
    "deploy:check": "node scripts/deploy.js --dry-run"
  },
  "keywords": [
    "claude",
    "claude-code",
    "coding-agent",
    "pi",
    "codex",
    "deepseek",
    "dsh",
    "omp",
    "cli",
    "llm",
