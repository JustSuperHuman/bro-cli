{
  "name": "@bro-cli/dsh-profiles",
  "version": "0.1.0",
  "description": "Claude and Codex account profile switcher for DeepSeek Harness.",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  }
}
