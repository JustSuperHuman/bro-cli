  "css": "/* Aurora Studio · gradients and glass for T3 Code web/desktop. No external resources. */\n:root.dark [data-workspace-area=\"conversation\"] {\n  background-image: radial-gradient(ellipse at 12% 0%, color-mix(in srgb, var(--app-theme-accent) 16%, transparent), transparent 60%), radial-gradient(ellipse at 100% 100%, color-mix(in srgb, var(--app-theme-message-action) 10%, transparent), transparent 58%);\n}\n:root:not(.dark) [data-workspace-area=\"conversation\"] {\n  background-image: radial-gradient(ellipse at 12% 0%, color-mix(in srgb, var(--app-theme-accent) 8%, transparent), transparent 62%);\n}\n:is([data-chat-header], [data-slot=\"composer-host\"]) {\n  background-color: color-mix(in srgb, var(--app-theme-surface) 84%, transparent);\n  backdrop-filter: saturate(1.15) blur(14px);\n  border-color: var(--app-theme-border);\n}\n:is([data-user-message-bubble], .chat-markdown-codeblock) {\n  border: 1px solid var(--app-theme-border);\n  border-radius: 16px;\n}\n"
